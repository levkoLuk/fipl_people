# Пример переменных окружения. Скопируйте в .env и заполните значения:
#   copy .env.example .env      (Windows)
#   cp .env.example .env        (Linux/macOS)
#
# Файл .env читает модуль config/env.py при загрузке настроек. Значения из
# настоящего окружения имеют приоритет над файлом, поэтому на сервере
# переменные можно задавать штатными средствами (systemd, docker compose).
# Путь к файлу можно переопределить переменной DJANGO_ENV_FILE.

DJANGO_SETTINGS_MODULE=config.settings
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,fiplpeople.ru
DJANGO_CSRF_TRUSTED_ORIGINS=https://fiplpeople.ru

# --- База данных ---
# Целевая СУБД — PostgreSQL.
DJANGO_DB_ENGINE=postgresql
POSTGRES_DB=fiplpeople
POSTGRES_USER=fiplpeople
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60
POSTGRES_SSLMODE=prefer
POSTGRES_TEST_DB=test_fiplpeople

# Для локальной проверки без сервера PostgreSQL:
# DJANGO_DB_ENGINE=sqlite
# DJANGO_DB_NAME=db.sqlite3

# --- Предметная область ---
ALLOWED_EMAIL_DOMAIN=g.nsu.ru
MAX_ATTACHMENT_SIZE_BYTES=209715200

# --- Почта ---
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=noreply@fiplpeople.ru
