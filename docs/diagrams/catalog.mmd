%% FIPLPEOPLE.RU — ER-диаграмма приложения catalog
%% Учебный каталог: семестры, дисциплины, связь семестр-дисциплина, типы материалов.
%% Источник истины: apps/catalog/models.py и миграции catalog/0001, catalog/0002.
%% verify: complete
erDiagram
    direction LR

    SEMESTER["catalog_semester · семестр"]:::catalog {
        bigint id PK "первичный ключ"
        smallint number UK "номер семестра, CHECK: >= 1"
        varchar(100) name "отображаемое название"
        boolean is_active "скрытие из каталога"
    }

    DISCIPLINE["catalog_discipline · дисциплина"]:::catalog {
        bigint id PK "первичный ключ"
        varchar(255) name "название дисциплины"
        varchar(255) slug UK "идентификатор в URL"
        text description "краткая аннотация"
        boolean is_active "скрытие из каталога"
    }

    SEMESTER_DISCIPLINE["catalog_semesterdiscipline · дисциплина семестра"]:::catalog {
        bigint id PK "первичный ключ"
        bigint semester_id FK "семестр"
        bigint discipline_id FK "дисциплина"
    }

    MATERIAL_TYPE["catalog_materialtype · тип материала"]:::catalog {
        bigint id PK "первичный ключ"
        varchar(100) name UK "Лекции, Семинары, Домашние задания и др."
        varchar(63) slug UK "идентификатор типа"
        boolean is_active "доступность при публикации"
    }

    ARTICLE_VERSION["content_articleversion · редакция статьи"]:::external {
        bigint id PK "внешняя сущность приложения content"
        bigint semester_discipline_id FK "привязка к паре семестр-дисциплина"
        bigint material_type_id FK "тип материала"
    }

    SEMESTER ||--o{ SEMESTER_DISCIPLINE : "включает дисциплины"
    DISCIPLINE ||--o{ SEMESTER_DISCIPLINE : "встречается в семестрах"
    SEMESTER_DISCIPLINE ||--o{ ARTICLE_VERSION : "каталогизирует материалы"
    MATERIAL_TYPE ||--o{ ARTICLE_VERSION : "типизирует материалы"

    classDef catalog fill:#e6f4ea,stroke:#3f8f5a,stroke-width:2px,color:#1f2933
    classDef external fill:#f5f5f5,stroke:#9e9e9e,stroke-width:2px,stroke-dasharray:4 3,color:#616161
