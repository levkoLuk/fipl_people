%% FIPLPEOPLE.RU — служебная схема Django (для справки)
%% Штатные таблицы фреймворка, обеспечивающие роли и административный журнал.
%% verify: complete
erDiagram
    direction LR

    USER["accounts_user · пользователь"]:::external {
        bigint id PK "первичный ключ"
        varchar(254) email UK "логин"
    }

    AUTH_GROUP["auth_group · группа (роль)"]:::system {
        integer id PK "первичный ключ"
        varchar(150) name UK "USER, MODERATOR, ADMIN"
    }

    AUTH_PERMISSION["auth_permission · разрешение"]:::system {
        integer id PK "первичный ключ"
        varchar(255) name "человекочитаемое название"
        integer content_type_id FK "тип модели"
        varchar(100) codename "например change_articleversion; уникален вместе с content_type"
    }

    DJANGO_CONTENT_TYPE["django_content_type · модель"]:::system {
        integer id PK "первичный ключ"
        varchar(100) app_label "приложение"
        varchar(100) model "модель"
    }

    USER_GROUPS["accounts_user_groups · членство в роли"]:::system {
        bigint id PK "первичный ключ"
        bigint user_id FK "пользователь"
        integer group_id FK "группа"
    }

    GROUP_PERMISSIONS["auth_group_permissions · права роли"]:::system {
        integer id PK "первичный ключ"
        integer group_id FK "группа"
        integer permission_id FK "разрешение"
    }

    USER_PERMISSIONS["accounts_user_user_permissions · личные права"]:::system {
        bigint id PK "первичный ключ"
        bigint user_id FK "пользователь"
        integer permission_id FK "разрешение"
    }

    DJANGO_ADMIN_LOG["django_admin_log · журнал админки"]:::system {
        integer id PK "первичный ключ"
        timestamptz action_time "когда выполнено"
        bigint user_id FK "кто выполнил"
        integer content_type_id FK "null: модель объекта"
        text object_id "null: идентификатор объекта"
        varchar(200) object_repr "представление объекта"
        smallint action_flag "1 добавление, 2 изменение, 3 удаление"
        text change_message "описание изменений"
    }

    DJANGO_SESSION["django_session · сессия"]:::system {
        varchar(40) session_key PK "ключ сессии"
        text session_data "данные"
        timestamptz expire_date "срок действия"
    }

    DJANGO_MIGRATIONS["django_migrations · история миграций"]:::system {
        bigint id PK "первичный ключ"
        varchar(255) app "приложение"
        varchar(255) name "миграция"
        timestamptz applied "когда применена"
    }

    DJANGO_CONTENT_TYPE ||--o{ AUTH_PERMISSION : "определяет права модели"
    AUTH_GROUP ||--o{ GROUP_PERMISSIONS : "содержит права"
    AUTH_PERMISSION ||--o{ GROUP_PERMISSIONS : "выдаётся группам"
    AUTH_PERMISSION ||--o{ USER_PERMISSIONS : "выдаётся напрямую"
    AUTH_GROUP ||--o{ USER_GROUPS : "включает пользователей"
    USER ||--o{ USER_GROUPS : "состоит в ролях"
    USER ||--o{ USER_PERMISSIONS : "личные права"
    USER ||--o{ DJANGO_ADMIN_LOG : "действия в админке"
    DJANGO_CONTENT_TYPE ||--o{ DJANGO_ADMIN_LOG : "объект действия"

    classDef system fill:#eceff1,stroke:#607d8b,stroke-width:1.5px,color:#1f2933
    classDef external fill:#f5f5f5,stroke:#9e9e9e,stroke-width:1.5px,stroke-dasharray:4 3,color:#616161
